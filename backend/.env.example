# Copia este archivo a backend/.env y completa los valores. backend/.env no se versiona.
#
# Local: los valores salen de `npx supabase@3.2.0 status` con el stack levantado (`supabase start`).
# Producción: Dashboard de Supabase → proyecto branchpoint → Connect / Settings → API Keys.

# Conexión directa a Postgres. La usa el backend para ProjectStore (rol postgres, sin RLS).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API de Supabase (Auth y Storage). Con SUPABASE_URL, las rutas /projects piden el token de sesión
# (Authorization: Bearer <access_token>) y cada usuario ve solo sus proyectos (JAJ-78).
SUPABASE_URL=http://127.0.0.1:54321
# Mientras el editor no tenga login (JAJ-77), apaga el login en local para poder usarlo. Sin login,
# los proyectos quedan sin dueño, como antes. En producción no se pone.
BRANCHPOINT_AUTH=off
# Solo si el proyecto de Supabase firma los tokens con el secreto compartido (HS256, el esquema
# antiguo). El stack local y los proyectos nuevos firman con claves asimétricas (JWKS) y no lo necesitan.
SUPABASE_JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=
# Secreta: solo en el servidor, nunca en el frontend ni en el repo.
SUPABASE_SECRET_KEY=
