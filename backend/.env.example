# Copia este archivo a backend/.env y completa los valores. backend/.env no se versiona.
#
# Local: los valores salen de `npx supabase@3.2.0 status` con el stack levantado (`supabase start`).
# Producción: Dashboard de Supabase → proyecto branchpoint → Connect / Settings → API Keys.

# Conexión directa a Postgres. La usa el backend para ProjectStore (rol postgres, sin RLS).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API de Supabase (Auth y Storage). Con SUPABASE_URL, las rutas /projects piden el token de sesión
# (Authorization: Bearer <access_token>) y cada usuario ve solo sus proyectos (JAJ-78).
SUPABASE_URL=http://127.0.0.1:54321
# Mientras el editor no tenga login (JAJ-77), apaga el login en local para poder usarlo. Sin login,
# los proyectos quedan sin dueño, como antes. En producción no se pone.
BRANCHPOINT_AUTH=off
# Solo si el proyecto de Supabase firma los tokens con el secreto compartido (HS256, el esquema
# antiguo). El stack local y los proyectos nuevos firman con claves asimétricas (JWKS) y no lo necesitan.
SUPABASE_JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=
# Secreta: solo en el servidor, nunca en el frontend ni en el repo. Con SUPABASE_URL, habilita los
# adjuntos del chat en Supabase Storage (IA-6).
SUPABASE_SECRET_KEY=
# Horas que vive un adjunto del chat antes de borrarse. Por defecto, 24.
# BRANCHPOINT_ATTACHMENT_TTL_HOURS=24

# GitHub App de Branchpoint (JAJ-57): conectar repos y analizarlos. Sin estas variables, /github/* responde 503.
# Los datos públicos de la app están en la issue JAJ-64 de Linear.
GITHUB_APP_ID=5861305
GITHUB_APP_SLUG=branchpoint-dev
GITHUB_APP_CLIENT_ID=Iv23liRbCZBiy2ZyzhBr
# Secretas: nunca en el repo. La private key va en un archivo fuera del repo (o su contenido en GITHUB_APP_PRIVATE_KEY).
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=~/.config/branchpoint/github-app.pem
# A dónde vuelve el navegador después de instalar la app (paso GitHub de /onboarding en el frontend).
BRANCHPOINT_FRONTEND_URL=http://localhost:3000
# URL pública de este backend. Su /github/callback va como redirect_uri del OAuth y tiene que estar en las
# Callback URL de la app (JAJ-84). En local se puede omitir: sale de la URL del request.
# En producción: https://branchpoint-api-laq9.onrender.com
BRANCHPOINT_API_URL=
# Tope del tarball del repo en MB (el plan free de Render tiene 512 MB de RAM). Por defecto, 80.
# BRANCHPOINT_MAX_TARBALL_MB=80

# Keys de Branchpoint, con cuota diaria por usuario para el chat y la extracción. Solo en el entorno del backend.
ANTHROPIC_API_KEY=
# Opcional: sin ella, OpenAI usa solo la key del usuario.
OPENAI_API_KEY=
# BRANCHPOINT_TEAM_CHAT_LIMIT=30
# BRANCHPOINT_TEAM_EXTRACT_LIMIT=5
# Tokens máximos de un análisis de repo con la key de Branchpoint (provisorio hasta medir con IA-0).
# BRANCHPOINT_TEAM_EXTRACT_TOKENS=1500000

# Modelo de cada proveedor, por separado para el chat (CHAT) y para leer el repo (EXTRACT).
# Sin la variable: claude-opus-5-5 y gpt-4.1-mini. Si el modelo no está en app/costs/prices/manual.json,
# el costo de los tokens se muestra vacío: no se inventa.
# BRANCHPOINT_ANTHROPIC_CHAT_MODEL=
# En desarrollo, el repo lo lee Sonnet 5.5 con effort medium: 3 veces más rápido y casi 4 veces más barato
# que Opus, con menos detalle de consultas por endpoint (spikes/jaj-146-cache-repos). Producción usa Opus 5.5
# con fast mode (docs/despliegue.md).
BRANCHPOINT_ANTHROPIC_EXTRACT_MODEL=claude-sonnet-5-5
# Effort del LLM que lee el repo: low, medium, high, xhigh o max. Sin la variable, el del modelo.
BRANCHPOINT_ANTHROPIC_EXTRACT_EFFORT=medium
# fast: 2,5 veces más rápido y el doble de caro. Solo Opus 5.5; con otro modelo se ignora.
# BRANCHPOINT_ANTHROPIC_EXTRACT_SPEED=fast
# BRANCHPOINT_OPENAI_CHAT_MODEL=
# BRANCHPOINT_OPENAI_EXTRACT_MODEL=
